# copy to .env — Vite exposes only VITE_* vars to the browser
# Supabase ANON (public) key — NOT the service-role key; RLS allows read-only
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon...
# FastAPI GEE-compute service (local dev default)
VITE_API_URL=http://127.0.0.1:8000
